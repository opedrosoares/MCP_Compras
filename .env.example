# ==============================================================
# Portal da Transparência (CGU) — sanções CEIS/CNEP/CEAF
# Cadastro gratuito em https://api.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Obrigatório para as tools compras_consultar_sancao_* e compras_checar_sancoes_fornecedor.
# ==============================================================
TRANSPARENCIA_API_KEY=

# ==============================================================
# Cache (opcional). Se REDIS_URL não estiver setada, usa cache TTL+LRU em memória.
# Recomendado em produção (Railway): habilite o plugin Redis para cache compartilhado.
# ==============================================================
# REDIS_URL=redis://localhost:6379/0

# ==============================================================
# Base URLs das APIs (default em produção; só altere para mocks/testes)
# ==============================================================
# DADOS_ABERTOS_BASE_URL=https://dadosabertos.compras.gov.br
# PNCP_BASE_URL=https://pncp.gov.br/api/consulta
# PNCP_API_BASE_URL=https://pncp.gov.br/api/pncp  # API de arquivos (TR, Edital, atas) — sem chave
# TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br

# ==============================================================
# HTTP timeouts e retries (defaults razoáveis para as APIs do gov)
# ==============================================================
# HTTP_TIMEOUT=60
# HTTP_MAX_RETRIES=2

# ==============================================================
# Cache TTLs (segundos) e tamanho máximo (LRU) por domínio
# ==============================================================
# CATMAT/CATSER mudam raramente: TTL longo
# CACHE_CATALOGO_TTL=86400
# CACHE_CATALOGO_MAX_SIZE=500

# Pesquisas de preço: TTL curto (dados podem mudar a cada novo pregão homologado)
# CACHE_PRECOS_TTL=600
# CACHE_PRECOS_MAX_SIZE=200

# Sanções: TTL moderado (consulta cara, API Transparência tem quota baixa)
# CACHE_SANCOES_TTL=3600
# CACHE_SANCOES_MAX_SIZE=300

# Atas e contratos: TTL curto
# CACHE_ATAS_TTL=900
# CACHE_ATAS_MAX_SIZE=200

# Órgãos/UASG: TTL longo (mudam raramente)
# CACHE_ORGAOS_TTL=86400
# CACHE_ORGAOS_MAX_SIZE=500

# ==============================================================
# LGPD / privacidade
# Por padrão, mascaramos CPFs em respostas (123.***.***-45). Set true para retornar completos.
# ==============================================================
# INCLUIR_CPF_COMPLETO=false

# ==============================================================
# v2 (não usado v1): JWT do Comprasnet Contratos (login gov.br)
# Stub presente em clients/comprasnet_contratos.py — só habilite quando v2 for liberada.
# ==============================================================
# COMPRASNET_BEARER_TOKEN=

# ==============================================================
# Logging
# ==============================================================
# LOG_LEVEL=INFO
